# Example .env file for Chat Configuration
# Copy this file to .env and fill in your actual values

# ===== REQUIRED =====

# Enable the chat feature
RETAIL_UI_CHAT_ENABLED=true

# Chat provider: openai, bedrock, or mock
RETAIL_UI_CHAT_PROVIDER=openai

# Model name from your API endpoint
# Common models:
# - deepseek/deepseek-v3.2 (DeepSeek via KodeKloud)
# - gpt-4 (if using real OpenAI)
RETAIL_UI_CHAT_MODEL=deepseek/deepseek-v3.2

# Your custom API endpoint URL
# Do NOT include /v1 — Spring AI appends it automatically
# Example: https://api.ai.kodekloud.com
RETAIL_UI_CHAT_OPENAI_BASE_URL=https://api.ai.kodekloud.com

# Your API authentication key
# Format: sk-... or similar
# Get this from your API provider
RETAIL_UI_CHAT_OPENAI_API_KEY=sk-YOUR-API-KEY-HERE

# ===== OPTIONAL =====

# Model temperature (0-1)
# Lower values (0-0.3) = more focused and deterministic
# Higher values (0.7-1.0) = more creative and random
# Default: 0.6
RETAIL_UI_CHAT_TEMPERATURE=0.6

# Maximum tokens in response
# Lower values = faster responses but less detailed
# Higher values = more detailed but slower
# Default: 300
RETAIL_UI_CHAT_MAX_TOKENS=300

# ===== BEDROCK ONLY =====
# If using provider=bedrock, also set:
# RETAIL_UI_CHAT_BEDROCK_REGION=us-east-1

# ===== HOW TO USE THIS FILE =====
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Source it before running: source .env
# 4. Then run: ./mvnw spring-boot:run
#
# IMPORTANT: Add .env to .gitignore to avoid committing secrets!
#
# ===== SECURITY NOTES =====
# - Never commit .env to Git
# - Keep API keys confidential
# - Rotate API keys regularly
# - Use HTTPS endpoints in production
# - Monitor API usage for unauthorized access
